# Platform-managed database and Manus OAuth values are injected by Webdev.
# Do not copy credentials into source files or commit a populated .env file.

# Set to the authorized owner's Manus openId to grant the first administrator role.
# Until configured, all OAuth accounts remain regular users and /admin is denied.
OWNER_OPEN_ID=replace-with-authorized-owner-open-id

# Set only after a real canonical HTTPS domain is configured and verified.
# This enables absolute canonical/social metadata and full sitemap locations.
SITE_PUBLIC_ORIGIN=

# Business contact values should be entered and verified by the owner in the dashboard.
BUSINESS_WHATSAPP_NUMBER=
BUSINESS_EMAIL=
BUSINESS_PHONE=

# Customer email notifications need an independently configured transactional provider.
# Add provider-specific credentials through protected project secret configuration only.
EMAIL_PROVIDER_CONFIGURED=false
